{
    "name": "anafro/avacha",
    "version": "1.1",
    "description": "A supercharged web framework.",
    "minimum-stability": "stable",
    "license": "MIT",
    "authors": [
        {
            "name": "Anatoly Frolov (anafro)",
            "email": "anatolyfroloff@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Avacha\\": "avacha/"
        },
        "files": [
            "avacha/Env/env.php",
            "avacha/Filesystem/paths.php",
            "avacha/Filesystem/dirs.php",
            "avacha/Assets/assets.php",
            "avacha/Http/responses.php",
            "avacha/Components/render.php",
            "avacha/Support/Strings/mb_charat.php",
            "avacha/Support/Strings/mb_tabulate.php",
            "avacha/Support/OutputBuffering/ob_capture.php",
            "avacha/Support/Sugar/varargs_1ormore_merge.php",
            "avacha/Support/Debug/sniff.php",
            "avacha/Support/Reflection/refl_simpleclassname.php",
            "avacha/Support/Arrays/array_areduce.php"
        ]
    },
    "require-dev": {
        "symfony/var-dumper": "^7.2"
    },
    "require": {
        "nikic/fast-route": "^1.3",
        "vlucas/phpdotenv": "^5.6",
        "ext-intl": "*"
    }
}
